---
import { otherGameGuides } from '../data/other-game-guides';
---

<section class="other-guides" aria-labelledby="other-guides-title">
	<header class="other-guides__head">
		<h2 id="other-guides-title">Other Games Guides</h2>
		<p>
			Dedicated articles for Fortnite, Tarkov, Warzone, Marvel Rivals, and more — mixed across titles
			below.
		</p>
	</header>

	<div class="other-guides__grid">
		{
			otherGameGuides.map((guide) => (
				<a
					class="other-guides__card"
					href={guide.url}
					target="_blank"
					rel="noopener noreferrer"
					style={`--guide-accent: ${guide.accent}; --guide-hue: ${guide.hue};`}
				>
					<div class="other-guides__media">
						<div class="other-guides__art" aria-hidden="true" />
						<p class="other-guides__label">{guide.label}</p>
					</div>
					<div class="other-guides__body">
						<h3>{guide.title}</h3>
						<p>{guide.description}</p>
					</div>
				</a>
			))
		}
	</div>
</section>

<style>
	.other-guides {
		display: grid;
		gap: 1.25rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.other-guides__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.other-guides__head p {
		margin: 0.45rem 0 0;
		max-width: 44rem;
		color: var(--ink-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.other-guides__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.other-guides__card {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid var(--line);
		background: var(--bg-panel);
		text-decoration: none;
		color: inherit;
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.other-guides__card:hover {
		border-color: color-mix(in srgb, var(--guide-accent) 55%, var(--line));
		transform: translateY(-2px);
		box-shadow: 0 10px 28px color-mix(in srgb, var(--bg) 35%, transparent);
	}

	.other-guides__media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 2px solid var(--guide-accent);
	}

	.other-guides__art {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(
				180deg,
				color-mix(in srgb, hsl(calc(var(--guide-hue) * 1deg) 55% 38%) 15%, transparent) 0%,
				color-mix(in srgb, var(--bg) 35%, transparent) 100%
			),
			radial-gradient(
				ellipse 120% 90% at 18% 20%,
				color-mix(in srgb, hsl(calc(var(--guide-hue) * 1deg) 70% 42%) 55%, transparent),
				transparent 62%
			),
			radial-gradient(
				ellipse 90% 80% at 82% 78%,
				color-mix(in srgb, var(--guide-accent) 35%, transparent),
				transparent 58%
			),
			linear-gradient(
				135deg,
				hsl(calc(var(--guide-hue) * 1deg) 42% 16%),
				hsl(calc(var(--guide-hue) + 24) * 1deg 38% 10%)
			);
	}

	.other-guides__art::after {
		content: '';
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(
				-24deg,
				transparent 0 14px,
				color-mix(in srgb, #fff 4%, transparent) 14px 15px
			);
		opacity: 0.35;
	}

	.other-guides__label {
		position: absolute;
		left: 0.75rem;
		bottom: 0.65rem;
		margin: 0;
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.65);
	}

	.other-guides__body {
		display: grid;
		gap: 0.45rem;
		padding: 0.95rem 1rem 1.05rem;
	}

	.other-guides__body h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--ink);
	}

	.other-guides__body p {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	@media (max-width: 980px) {
		.other-guides__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.other-guides__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
