---
import { otherGameGuides } from '../data/other-game-guides';
---

<section class="other-guides" aria-labelledby="other-guides-title">
	<header class="other-guides__head">
		<h2 id="other-guides-title">Other Games Guides</h2>
		<p>
			Dedicated articles for Fortnite, Tarkov, Warzone, Marvel Rivals, and more — mixed across titles
			below.
		</p>
	</header>

	<div class="other-guides__grid">
		{
			otherGameGuides.map((guide) => (
				<a
					class="other-guides__card"
					href={guide.url}
					target="_blank"
					rel="noopener noreferrer"
					style={`--guide-accent: ${guide.accent}; --guide-hue: ${guide.hue};`}
				>
					<div class="other-guides__media">
						<img
							class="other-guides__thumb"
							src={guide.thumbnail}
							alt={guide.thumbnailAlt}
							width="640"
							height="360"
							loading="lazy"
							decoding="async"
						/>
						<div class="other-guides__shade" aria-hidden="true" />
						<p class="other-guides__label">{guide.label}</p>
					</div>
					<div class="other-guides__body">
						<h3>{guide.title}</h3>
						<p>{guide.description}</p>
					</div>
				</a>
			))
		}
	</div>
</section>

<style>
	.other-guides {
		display: grid;
		gap: 1.25rem;
		padding-top: 0.5rem;
		border-top: 1px solid var(--line-soft);
	}

	.other-guides__head h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.other-guides__head p {
		margin: 0.45rem 0 0;
		max-width: 44rem;
		color: var(--ink-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.other-guides__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.other-guides__card {
		display: grid;
		grid-template-rows: auto 1fr;
		overflow: hidden;
		border-radius: var(--radius-md, 0.75rem);
		border: 1px solid color-mix(in srgb, var(--line-strong) 70%, var(--guide-accent) 30%);
		background:
			linear-gradient(180deg, var(--bg-panel) 0%, color-mix(in srgb, var(--bg-elevated) 88%, var(--bg-panel)) 100%);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 4%, transparent) inset,
			0 8px 22px color-mix(in srgb, var(--bg) 55%, transparent);
		text-decoration: none;
		color: inherit;
		transform: translateY(0) scale(1);
		transition:
			border-color 0.28s ease,
			transform 0.28s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.28s ease;
		will-change: transform;
	}

	.other-guides__card:hover,
	.other-guides__card:focus-visible {
		border-color: color-mix(in srgb, var(--guide-accent) 72%, var(--line-strong));
		transform: translateY(-8px) scale(1.025);
		box-shadow:
			0 1px 0 color-mix(in srgb, #fff 8%, transparent) inset,
			0 0 0 1px color-mix(in srgb, var(--guide-accent) 28%, transparent),
			0 18px 40px color-mix(in srgb, var(--bg) 25%, transparent),
			0 0 28px color-mix(in srgb, var(--guide-accent) 22%, transparent);
	}

	.other-guides__card:focus-visible {
		outline: 2px solid var(--guide-accent);
		outline-offset: 3px;
	}

	.other-guides__media {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-bottom: 3px solid var(--guide-accent);
	}

	.other-guides__thumb {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center center;
		transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.other-guides__card:hover .other-guides__thumb,
	.other-guides__card:focus-visible .other-guides__thumb {
		transform: scale(1.06);
	}

	.other-guides__shade {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			transparent 35%,
			color-mix(in srgb, var(--bg) 20%, transparent) 70%,
			color-mix(in srgb, var(--bg) 72%, transparent) 100%
		);
		pointer-events: none;
	}

	.other-guides__label {
		position: absolute;
		left: 0.75rem;
		bottom: 0.65rem;
		margin: 0;
		padding: 0.18rem 0.45rem;
		border-radius: 0.25rem;
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: #fff;
		background: color-mix(in srgb, var(--bg) 55%, transparent);
		border: 1px solid color-mix(in srgb, #fff 12%, transparent);
		backdrop-filter: blur(4px);
	}

	.other-guides__body {
		display: grid;
		gap: 0.45rem;
		padding: 0.95rem 1rem 1.05rem;
		border-top: 1px solid color-mix(in srgb, var(--line-soft) 80%, var(--guide-accent) 20%);
	}

	.other-guides__body h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.98rem;
		font-weight: 800;
		line-height: 1.25;
		color: var(--ink);
		transition: color 0.2s ease;
	}

	.other-guides__card:hover .other-guides__body h3,
	.other-guides__card:focus-visible .other-guides__body h3 {
		color: color-mix(in srgb, var(--guide-accent) 35%, var(--ink));
	}

	.other-guides__body p {
		margin: 0;
		font-size: 0.82rem;
		line-height: 1.55;
		color: var(--ink-muted);
	}

	@media (max-width: 980px) {
		.other-guides__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 640px) {
		.other-guides__grid {
			grid-template-columns: 1fr;
		}

		.other-guides__card:hover,
		.other-guides__card:focus-visible {
			transform: translateY(-4px) scale(1.015);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.other-guides__card,
		.other-guides__thumb {
			transition: none;
		}

		.other-guides__card:hover,
		.other-guides__card:focus-visible {
			transform: none;
		}
	}
</style>
